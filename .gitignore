# --- Secrets / credentials (never commit) ---
.env
.env.*
*.pem
*.key
aws.json
credentials
.aws/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# --- Terraform (state can contain secrets; never commit) ---
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl

# --- Build / packaging artefacts ---
dist/
build/
*.zip

# --- Editor / OS noise ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Claude Code / agent files (local only, not needed to run the app) ---
CLAUDE.md
.claude/
.mcp.json

# --- Reference material (local only, not needed to run the app) ---
docs/*.pdf
docs/*.md
